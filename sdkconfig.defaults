CONFIG_IDF_TARGET="esp32s3"

# This board's flash chip is actually 16MB (the boot log reports
# "Detected size(16384k)"), not the 2MB the default partition tables
# assume. Use a custom table sized for the real chip so there's room for
# the embedded FreeType font without fighting for flash space.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# FreeType (via esp_lvgl_adapter) is used to render Norwegian text (ae/oe/aa)
# correctly - the bundled bitmap Montserrat fonts only cover ASCII plus a
# small icon-symbol set. LVGL v9's FreeType binding only loads fonts from a
# file path (not memory), so the .ttf is packaged into the "fonts" SPIFFS
# partition (see main/CMakeLists.txt) and mounted at runtime via esp_lv_fs.
CONFIG_LV_USE_FREETYPE=y
CONFIG_LV_FREETYPE_USE_LVGL_PORT=y
# Our on-screen text uses a small character set (digits, a handful of
# Latin/Norwegian letters) across 2 font sizes; the 256-entry default glyph
# cache was a large, otherwise-unaccounted-for internal DRAM consumer.
CONFIG_LV_FREETYPE_CACHE_FT_GLYPH_CNT=96
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS=y
# esp_lv_decoder integration: the adapter calls esp_lv_decoder_init() during
# esp_lv_adapter_init(), registering a PNG decoder with LVGL so the MET
# weather icons (F:<symbol_code>.png on the mounted asset drive) render via
# lv_image. Decoded frames are allocated from PSRAM by the decoder.
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FREETYPE=y
CONFIG_ESP_LVGL_ADAPTER_FREETYPE_MINIMAL_BUILD=y
# FREETYPE_SMALL_RENDER_POOL (16KB -> 4KB) was tried to save RAM, but it also
# strips LVGL's build-time check that the draw-thread stack is >=32KB when
# FreeType is enabled. Without that check, the (default 8KB) draw-thread
# stack overflowed during glyph rasterization, corrupting memory and
# crashing with a different fault each run. Fix is to size the stack
# properly instead of disabling the check.
CONFIG_LV_DRAW_THREAD_STACK_SIZE=32768
# That 32KB "swdraw" stack can't be shrunk (see above), but it doesn't have
# to live in scarce internal DRAM: the draw thread only rasterizes glyphs
# and blits software layers - it never runs with the flash cache disabled
# (NVS writes here happen only at boot and just before a reboot) - so its
# stack is safe in PSRAM. This frees ~32KB of internal DRAM.
CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM=y

# That 32KB stack (up from 8KB) left too little internal DRAM for WiFi's
# own static RX buffers ("esf_buf_setup_static: alloc eb fail") and later
# for DNS/TLS during the weather fetch (getaddrinfo failures, largest free
# block down to ~7KB). Trim WiFi's buffer counts to claw back headroom;
# this is a small display fetching a REST API every 10 minutes, not a
# high-throughput link, so reduced buffering doesn't cost anything real.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# Static TX buffers are 1.6KB each of DMA-capable internal RAM, allocated up
# front at esp_wifi_init(). The default 16 (~25KB) is sized for a
# high-throughput link; this display just makes an HTTPS GET every few
# minutes, so 8 is ample and frees ~13KB of internal DRAM.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# Deliberately skip TLS server certificate verification for the yr_client
# fetch (see components/yr_client.c) - verifying api.met.no's 4096-bit RSA
# chain doesn't reliably fit in this board's internal RAM once
# LVGL+FreeType+WiFi have their share. This is a read-only fetch of public
# weather data, confirmed acceptable with the user for this project.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# The HARICA/GEANT chain behind api.met.no uses 3072/4096-bit RSA certs.
# "PK verify failed" == MBEDTLS_ERR_MPI_ALLOC_FAILED here is a heap
# allocation failure, not an actual crypto/signature bug - internal DRAM is
# scarce on this board (LVGL + WiFi + FreeType all compete for it).
# LARGE_KEY_SOFTWARE_MPI (route big-key math through software instead of the
# HW accelerator) was tried on the assumption the HW path was broken for
# these key sizes, but that was never actually confirmed - and software MPI
# needs several KB of heap-allocated scratch per big-number operation, which
# made the heap pressure worse, not better. The HW accelerator uses its own
# fixed-size peripheral memory instead of general heap, so leave it enabled
# for all key sizes.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Free the CA certificate (and any client key/DHM data) right after the
# handshake instead of holding it for the connection's lifetime - reclaims
# memory exactly before the response-read phase, which is where fetches
# were failing before this was added.
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# A smaller (8KB) RX buffer was tried first, but the HARICA/GEANT chain's
# certificate message during the TLS handshake didn't fit in it (handshake
# failed with MBEDTLS_ERR_SSL_BAD_INPUT_DATA before ever reaching the
# read-response phase). 16KB is the size that actually works end-to-end;
# free up internal DRAM elsewhere instead of shrinking this further.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
# mbedtls's TLS scratch buffers (4-5KB each) were being forced into scarce
# internal DRAM by the default 16KB threshold, even though they're pure
# CPU-accessed buffers with no DMA/internal-RAM requirement and PSRAM had
# plenty of room. Letting anything >=1KB spill to PSRAM fixed allocation
# failures during the TLS handshake without touching any buffer's actual
# size. Small/frequent allocations (<1KB, e.g. LVGL style internals) still
# default to internal RAM for speed.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# mbedtls defaults to CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC, which pins every TLS
# allocation to internal DRAM with an explicit MALLOC_CAP_INTERNAL and so
# bypasses the SPIRAM_MALLOC_ALWAYSINTERNAL threshold above entirely - the
# ~16KB handshake RX buffer failed ("Dynamic Impl: alloc(16749 bytes)
# failed"). DEFAULT_MEM_ALLOC (plain malloc) moved the big buffers out but
# still kept every allocation under 1KB internal, and a handshake makes
# lots of those: a forecast fetch while LVGL drew a screen took internal
# DRAM down to ~2KB, with WiFi's own buffers failing. EXTERNAL puts all of
# mbedtls in PSRAM; handshakes are a little slower, which doesn't matter for
# a fetch every few seconds at most.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
# One draw thread instead of two: each needs a 32KB stack once FreeType is
# enabled, and WiFi's static RX buffers were failing to allocate (ESP_ERR_NO_MEM)
# with two. Not performance-critical for a mostly-static weather display.
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
# CONFIG_LV_USE_FONT_COMPRESSED is not set
# CONFIG_LV_USE_IMGFONT is not set
# CONFIG_LV_USE_LOG is not set
# CONFIG_LV_LOG_PRINTF is not set
# CONFIG_LV_USE_PERF_MONITOR is not set
# CONFIG_LV_USE_DEMO_BENCHMARK is not set
# CONFIG_LV_USE_DEMO_STRESS is not set
# CONFIG_LV_USE_DEMO_MUSIC is not set
# CONFIG_LV_DEMO_MUSIC_AUTO_PLAY is not set
# GET /screen.png on the config web server (h_screenshot in main.c).
CONFIG_LV_USE_SNAPSHOT=y
# Abort (panic, backtrace, restart) on an LVGL assert instead of spinning
# forever with the display lock held - see config/lv_assert_abort.h.
CONFIG_LV_ASSERT_HANDLER_INCLUDE="lv_assert_abort.h"
# A firmware update (POST /ota) boots once on probation: unless it marks
# itself valid (after the weather task's first full pass, so WiFi, the
# fetches and the screen all work), the bootloader goes back to the
# previous firmware on the next restart.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# LVGL's NULL-pointer asserts are off: one fires spuriously when a FreeType
# glyph fails to render (lv_draw_buf_destroy(NULL), which it then handles),
# and with the assert handler aborting that restarted the device. A real
# NULL dereference still panics and restarts.
# CONFIG_LV_USE_ASSERT_NULL is not set

# Signed firmware updates without hardware Secure Boot (no eFuses burnt, the
# board can always be re-flashed over USB). The build signs the app with
# keys/ota_signing_key.pem (RSA-3072, kept out of git), and esp_ota_end()
# refuses any update - the setup page upload and the automatic updater alike
# - not signed with the same key as the running firmware. See
# docs/auto-update-plan.md.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/ota_signing_key.pem"

# Crash dumps to the coredump partition, read back over WiFi from /coredump
# (main/diag.c) and decoded with `idf.py coredump-info -c <file>`. The binary
# format, as ELF needs larger interrupt stacks (1.1 KB more internal DRAM);
# 32 tasks is well above the ~16 this firmware runs.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_BIN=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32
CONFIG_FREERTOS_ISR_STACKSIZE=1536

# mDNS (multidisplay.local): its task stack and allocations in PSRAM, as
# internal DRAM is the scarce kind here.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# Large static arrays marked EXT_RAM_BSS_ATTR (route cache, rain grid,
# chart data, ...) go to PSRAM, leaving internal DRAM for WiFi and TLS.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# The clock (main/clock.c): the router's NTP server if DHCP names one, plus
# two public pools; no random start-up delay.
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set
