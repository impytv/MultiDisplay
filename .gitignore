# Build output (regenerated by `idf.py build`)
build/

# Component manager cache (regenerated by `idf.py build` from
# dependencies.lock + the idf_component.yml manifests; needs internet on
# first build, see README)
managed_components/

# Local configuration. This is where WiFi credentials, the forecast
# location, and the YR User-Agent (see main/Kconfig.projbuild) actually end
# up once set via `idf.py menuconfig` - keep it out of version control.
# sdkconfig.defaults (checked in) has the shared, non-secret project
# defaults; a fresh clone regenerates sdkconfig from it automatically.
sdkconfig
sdkconfig.old

# Editor/IDE state (machine-specific absolute paths)
.vscode/
