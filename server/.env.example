# Copy to server/.env (kept out of git) to serve the update site through a
# Cloudflare Tunnel as well as on the LAN. The token is the one Cloudflare
# shows when the tunnel is created; anyone holding it can run the tunnel.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# How long a paused radio station is recorded for Sonos to go on from
# (radio/radio_proxy.py), in minutes; 60 if left out.
#RADIO_PAUSE_MINUTES=60

# Error reports from the displays (feil/feil.py): pushed to this ntfy topic
# with the screenshot; subscribe to it in the ntfy app. Anyone who knows the
# name can read the pushes, so make it long and random, e.g. from
#   python3 -c "import secrets; print('vaertavla-' + secrets.token_urlsafe(18))"
# Without it, reports are only kept in the folder.
#NTFY_TOPIC=
# Another ntfy server than ntfy.sh, and where the reports are kept
# (./feilmeldinger next to compose.yaml unless set).
#NTFY_SERVER=https://ntfy.sh
#MULTIDISPLAY_REPORTS=/srv/multidisplay-feil
