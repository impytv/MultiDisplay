# Copy to server/.env (kept out of git) to serve the update site through a
# Cloudflare Tunnel as well as on the LAN. The token is the one Cloudflare
# shows when the tunnel is created; anyone holding it can run the tunnel.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# How long a paused radio station is recorded for Sonos to go on from
# (radio/radio_proxy.py), in minutes; 60 if left out.
#RADIO_PAUSE_MINUTES=60
